// CleanOps 核心数据库结构 V1.0 (2026版)
// 适用架构：Next.js + NestJS + PostgreSQL

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN    // 老板/管理员
  MANAGER  // 经理/主管
  WORKER   // 普通员工
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ServiceType {
  REGULAR         // 常规家居清洁
  DEEP_CLEAN      // 深度/开荒清洁
  END_OF_TENANCY  // 退租清洁
  COMMERCIAL      // 商业/办公室清洁
  WINDOW          // 窗户清洁
  CARPET          // 地毯清洁
  OVEN            // 烤箱清洁
}

enum PropertySize {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  FOUR_BED
  FIVE_PLUS_BED
  COMMERCIAL_SMALL
  COMMERCIAL_LARGE
}

enum ServiceFrequency {
  ONE_OFF
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

// 1. 公司 (租户隔离核心)
model Company {
  id                String   @id @default(uuid())
  name              String
  slug              String?  @unique // 公开预订页面用 (e.g. "dublin-cleaning-co")
  vatNumber         String?  // 爱尔兰 VAT 号码
  baseHourlyRate    Int      @default(1480) // 默认起薪 14.80 欧元 (以分存储)
  pensionEnrollment Boolean  @default(true) // 是否开启 2026 自动养老金计划 (1.5%)

  // SaaS 订阅
  stripeCustomerId   String?   // Stripe Customer ID
  subscriptionStatus String?   // TRIALING | ACTIVE | PAST_DUE | CANCELLED | NONE
  subscriptionPlan   String?   // STARTER | PRO | BUSINESS
  subscriptionEndsAt DateTime? // 当前订阅周期结束时间
  trialEndsAt        DateTime? // 14天试用截止

  // Stripe Connect (公司收自己的款)
  stripeAccountId       String?   // Connect 账户 ID (acct_xxxx)
  stripeAccountStatus   String?   // enabled | restricted | pending
  stripeAccountEmail    String?   // Stripe 账户关联邮箱

  // Xero integration
  xeroTenantId          String?
  xeroTenantName        String?
  xeroAccessToken       String?
  xeroRefreshToken      String?
  xeroTokenExpiresAt    DateTime?
  xeroConnectedAt       DateTime?

  // Marketing & Reputation
  googleReviewUrl   String?   // Google Business Profile 评价链接

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // 关系
  users             User[]      // 后台管理账号
  workers           Worker[]    // 清洁工
  customers         Customer[]  // 客户库
  jobs              Job[]       // 任务库
  invoices          Invoice[]   // 账单库
  quotes            Quote[]     // 报价库
}

// 2. 后台管理用户
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  role                Role      @default(WORKER) // 默认角色是员工
  resetToken          String?
  resetTokenExpiresAt DateTime?
  refreshToken        String?  // SHA256 hash of refresh token

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  worker    Worker? // 允许通过 user 找到对应的 worker 档案
}

// 3. 清洁工
model Worker {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  phone         String   @unique // 核心：WhatsApp 登录唯一凭证
  email         String?
  ppsn          String?  // 爱尔兰个人税号 (用于报税)
  hourlyRate    Int?     // 个体时薪 (分)，为空则使用 Company 默认值
  isActive      Boolean  @default(true)
  postalCode    String?  // Eircode 或类似邮编
  lat           Float?   // 地理编码：纬度
  lng           Float?   // 地理编码：经度
  skills        ServiceType[]  // 技能标签
  workDays      Int[]    @default([1,2,3,4,5]) // 0=周日...6=周六
  
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   JobAssignment[] // 关联的任务
}

// 4. 客户
model Customer {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String?
  address       String   // 物理地址
  postalCode    String?  // 爱尔兰 Eircode 邮编
  accessCode    String?  // 附加信息：如公寓大门密码 (都柏林刚需)
  lat           Float    // 纬度：用于地缘围栏打卡校验
  lng           Float    // 经度：用于地缘围栏打卡校验
  isCommercial        Boolean   @default(false) // 商业客户(23% VAT)还是住宅客户(13.5% VAT)
  authToken           String?   // 客户自助门户 magic link token (一次性，30min TTL)
  authTokenExpiresAt  DateTime?
  sessionToken        String?   @unique // 门户会话 token (7天 TTL)
  sessionTokenExpiresAt DateTime?

  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  jobs          Job[]
  quotes        Quote[]
}

// 5. 报价
model Quote {
  id                String        @id @default(uuid())
  status            QuoteStatus   @default(DRAFT)
  publicToken       String?       @unique // 公开查看 token

  // 服务详情
  serviceType       ServiceType
  propertySize      PropertySize
  bathrooms         Int?
  frequency         ServiceFrequency @default(ONE_OFF)
  isCommercial      Boolean       @default(false)
  estimatedDuration Int           // 预估时长（分钟）
  notes             String?       @db.Text

  // 定价 (cents)
  subtotal          Int
  vatAmount         Int
  grandTotal        Int
  depositRequired   Boolean       @default(false)
  depositAmount     Int?

  // 客户信息
  customerName      String
  customerEmail     String
  customerPhone     String?
  customerAddress   String
  customerPostalCode String?
  customerAccessCode String?

  // 生命周期
  validUntil        DateTime
  sentAt            DateTime?
  acceptedAt        DateTime?
  declinedAt        DateTime?
  declinedReason    String?       @db.Text

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // 关联
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])

  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])

  jobId             String?       @unique
  job               Job?          @relation(fields: [jobId], references: [id])

  lineItems         QuoteLineItem[]
}

// 6. 报价明细行项
model QuoteLineItem {
  id              String   @id @default(uuid())
  description     String
  quantity        Int      // 小时数或单位数
  unitPrice       Int      // 单价 (cents)
  totalPrice      Int      // 合计 (cents)
  sortOrder       Int      @default(0)

  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// 7. 任务 (工单)
model Job {
  id              String    @id @default(uuid())
  title           String?
  description     String?
  scheduledStart  DateTime
  scheduledEnd    DateTime?
  
  // 状态机: PENDING, IN_PROGRESS, COMPLETED, ISSUE, CANCELLED
  status          String    @default("PENDING")
  internalNotes   String?   @db.Text // 用于记录意外状况或纠纷备注
  notes           String?   // 创建任务时的备注信息
  estimatedDuration Int?     // 预计耗时（分钟）
  timeWindow    String    @default("ANY") // MORNING | AFTERNOON | ANY

  // 地缘围栏打卡数据
  actualStart     DateTime?
  actualEnd       DateTime?
  startLocationLat Float?
  startLocationLng Float?
  endLocationLat   Float?
  endLocationLng   Float?
  
  // 重复任务逻辑
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?   // "WEEKLY", "BI-WEEKLY"
  recurrenceLastDate DateTime? // 最近一次生成实例的日期，用于 cron 判断下次生成时机

  // 定金 (爱尔兰市场: end-of-tenancy / one-off 大单需要)
  depositAmount   Int?
  isDepositPaid   Boolean   @default(false)

  // 服务提醒
  reminderSentAt  DateTime? // 上次发送服务提醒邮件的时间
  // 评价邀请
  reviewSentAt    DateTime? // 上次发送评价邀请邮件的时间

  // 时间戳
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // 关联
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  
  assignments     JobAssignment[]
  photos          JobPhoto[]
  invoice         Invoice?
  quote           Quote?
}

// 6. 任务-员工多对多中间表
model JobAssignment {
  id        String   @id @default(uuid())
  jobId     String
  workerId  String
  job       Job      @relation(fields: [jobId], references: [id])
  worker    Worker   @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
}

// 7. 任务现场照片
model JobPhoto {
  id        String   @id @default(uuid())
  url       String
  publicId  String   @default("") // Cloudinary public_id for deletion
  type      String   @default("BEFORE") // BEFORE | AFTER | CHECKIN
  createdAt DateTime @default(now())

  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// 8. 账单
model Invoice {
  id              String    @id @default(uuid())
  invoiceNumber   Int?      // 公司范围内连续编号
  amount          Int       // 总金额 (分)
  vatAmount       Int       // 税额 (分)
  // 状态: UNPAID, PAID, VOID
  status          String    @default("UNPAID")
  paymentMethod   String?   // STRIPE, CASH, REVOLUT, BANK_TRANSFER
  paymentLink     String?   // 存储生成的支付链接
  paidAt          DateTime?
  reminderSentAt  DateTime? // 最近催款时间
  reminderCount   Int       @default(0) // 催款次数
  xeroInvoiceId   String?   // 同步到 Xero 后的 Invoice ID
  xeroSyncedAt    DateTime? // 同步时间
  createdAt       DateTime  @default(now())

  jobId           String    @unique
  job             Job       @relation(fields: [jobId], references: [id])

  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, invoiceNumber])
}