# Database
DATABASE_URL=postgresql://dba_yzy:password@localhost:5432/db-cleanops

# Auth
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRATION_TIME=1d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Stripe Connect
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_PERCENT=1

# Stripe Price IDs
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_...
STRIPE_BUSINESS_YEARLY_PRICE_ID=price_...

# Email via Resend (optional — emails skipped if unset)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@cleanops.com

# Cloudinary for job photos (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# Google Maps (optional — map page hidden if unset)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
