# ==================== Database ====================
DATABASE_URL="postgresql://dba_yzy:password@localhost:5432/db-cleanops"

# ==================== JWT ====================
JWT_SECRET="your-jwt-secret"
JWT_EXPIRATION_TIME="7d"

# ==================== Frontend ====================
FRONTEND_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ==================== Stripe (required for payments) ====================
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_

# ==================== Stripe Connect (required for cleaner payouts) ====================
# Get from Stripe Dashboard → Settings → Connect → Platform settings
STRIPE_CONNECT_CLIENT_ID=ca_
# Create webhook endpoint at Stripe Dashboard → Developers → Webhooks
# URL: https://your-domain/invoice/webhook/connect
# Events: account.updated
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_

# ==================== Stripe Webhooks ====================
# Create webhook endpoint for standard payments
# URL: https://your-domain/invoice/webhook
# Events: checkout.session.completed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_

# Create webhook endpoint for billing/subscriptions
# URL: https://your-domain/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_BILLING_WEBHOOK_SECRET=whsec_

# ==================== Platform Fee ====================
# Platform commission percentage on Connect payments
PLATFORM_FEE_PERCENT=1

# ==================== Subscription Price IDs ====================
# Create products & prices at https://dashboard.stripe.com/test/products
# Monthly prices
STRIPE_STARTER_MONTHLY_PRICE_ID=price_
STRIPE_PRO_MONTHLY_PRICE_ID=price_
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_

# Yearly prices (optional, set up later)
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=

# ==================== Google Maps ====================
# Get from https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EMAIL_FROM="cleanops<noreply@your-domain.com>"
RESEND_API_KEY="re_"

# ==================== Cloudinary (image uploads) ====================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
